# =====================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN Y DESPLIEGUE EN AWS (EC2 + S3)
# =====================================================================
# Copiar este archivo como '.env' en la instancia EC2 antes de levantar Docker:
#   cp .env.production.example .env
# Y ajustar los valores marcados como CAMBIAR.
# =====================================================================

# --- Base de datos PostgreSQL (En contenedor Docker dentro de EC2) ---
POSTGRES_DB=sortmatic
POSTGRES_USER=sortmatic
POSTGRES_PASSWORD=PonerUnaContrasenaSeguraPostgres2026!

# --- Configuración del Backend Django ---
# Generar una clave secreta única ejecutando en PowerShell o Linux:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria-en-produccion-aws

# En producción, desactivar DEBUG
DJANGO_DEBUG=false

# En producción sin dominio SSL (usando IP pública directamente), desactivar el redireccionamiento a HTTPS:
DJANGO_FORZAR_HTTPS=false

# IP pública o Dominio asignado a tu instancia EC2 de AWS (ejemplo: sortmatic.miempresa.com o 54.123.45.67)
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOW_ALL=true
DJANGO_TIME_ZONE=America/La_Paz

# --- Clave de Integración del Módulo de Visión ---
# Debe coincidir con la clave que use vision/inspector_botellas.py en la PC de planta (SORTMATIC_API_KEY)
VISION_API_KEY=ClaveVisionSeguraProducion2026_AWS_EMBOL!

# --- Configuración de Almacenamiento en AWS S3 (Opcional) ---
# Si deseas que las fotos de descarte vayan a un Bucket S3 en vez del disco de la EC2:
# DJANGO_ALMACENAMIENTO=s3
# AWS_STORAGE_BUCKET_NAME=sortmatic-mermas-fotos
# AWS_S3_REGION_NAME=us-east-1

# --- Sesiones JWT y Rate Limiting ---
JWT_MINUTOS_ACCESO=60
JWT_DIAS_REFRESCO=7
THROTTLE_LOGIN=10/min
