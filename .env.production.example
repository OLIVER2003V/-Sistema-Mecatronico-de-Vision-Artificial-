# =====================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN Y DESPLIEGUE EN AWS (EC2 + S3)
# =====================================================================
# Copiar este archivo como '.env' en la raíz del proyecto en tu instancia EC2:
#   cp .env.production.example .env
# =====================================================================

# --- 1. Base de datos PostgreSQL (Contenedor 'db' en EC2) ---
POSTGRES_DB=sortmatic
POSTGRES_USER=sortmatic
POSTGRES_PASSWORD=PonerUnaContrasenaSeguraPostgres2026!

# --- 2. Backend Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria-en-produccion-aws
DJANGO_DEBUG=false
DJANGO_FORZAR_HTTPS=false
DJANGO_ALLOWED_HOSTS=sortmatic-botellas.duckdns.org,backend,localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL=true
DJANGO_TIME_ZONE=America/La_Paz

# --- 3. Clave de Seguridad para el Sistema de Visión e IA ---
# Debe coincidir con la clave que use vision/inspector_botellas.py en la PC de planta
VISION_API_KEY=ClaveVisionSeguraProducion2026_AWS_EMBOL!

# --- 4. Microservicio de IA Generativa (servicio_ia) ---
# Clave API de Google Gemini (Obtener en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Lista ordenada de modelos para fallback automático ante errores 503/429
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-3.6-flash

# --- 5. Configuración de Almacenamiento en AWS S3 (Opcional) ---
DJANGO_ALMACENAMIENTO=local
# AWS_STORAGE_BUCKET_NAME=sortmatic-mermas-fotos
# AWS_S3_REGION_NAME=us-east-1

# --- 6. Sesiones JWT y Rate Limiting ---
JWT_MINUTOS_ACCESO=60
JWT_DIAS_REFRESCO=7
THROTTLE_LOGIN=10/min
