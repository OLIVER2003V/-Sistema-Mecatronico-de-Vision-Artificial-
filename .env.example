# Copiar a .env y ajustar antes de "docker compose up". .env NO se sube al repo.

# --- Base de datos ---
POSTGRES_DB=sortmatic
POSTGRES_USER=sortmatic
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Django ---
# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOW_ALL=true
DJANGO_TIME_ZONE=America/La_Paz

# --- Clave del modulo de vision ---
# vision/ no tiene usuario: se identifica con esta clave en la cabecera
# X-API-Key. Tiene que ser LA MISMA en vision/config.json -> backend.api_key
# (o en la variable de entorno SORTMATIC_API_KEY de esa PC).
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VISION_API_KEY=clave-vision-de-desarrollo-cambiar-en-produccion

# --- Sesiones (JWT) ---
JWT_MINUTOS_ACCESO=60
JWT_DIAS_REFRESCO=7
THROTTLE_LOGIN=10/min

# 
# Produccion en AWS (EC2 / ECS). Con DJANGO_DEBUG=false el backend NO
# arranca si quedaron las claves de desarrollo o ALLOWED_HOSTS en "*".

# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=sortmatic.embol.com.bo,10.0.1.25
# DJANGO_CORS_ALLOW_ALL=false
# DJANGO_CORS_ORIGINS=https://sortmatic.embol.com.bo
# DJANGO_CSRF_ORIGINS=https://sortmatic.embol.com.bo
# DJANGO_FORZAR_HTTPS=true

# Fotos de descarte en S3 en vez del disco del contenedor (que es efimero).
# Sin claves: se usa el rol IAM de la instancia EC2 / la task role de ECS.
# DJANGO_ALMACENAMIENTO=s3
# AWS_STORAGE_BUCKET_NAME=sortmatic-mermas
# AWS_S3_REGION_NAME=us-east-1

# Postgres gestionado (RDS) y Redis gestionado (ElastiCache).
# POSTGRES_HOST=sortmatic.abc123.us-east-1.rds.amazonaws.com
# REDIS_HOST=sortmatic.abc123.cache.amazonaws.com
